# ==============================================================================
# Git Ignore Configuration — Affidavit AI System
# ==============================================================================

# --- Environment Variables & Secrets (CRITICAL: NEVER COMMIT) ---
.env
.env.*
!.env.example
*.local
backend/.env

# --- Python Cache & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Operating System Files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Logs & Diagnostics ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Scratch & Temporary Test Files ---
scratch/
temp/
tmp/
*.tmp

# --- Generated Document Outputs ---
# Exclude ad-hoc generated test runs; preserve core reference assignment deliverables
outputs/*
!outputs/generated_affidavit.docx
!outputs/evaluation_report.json
!outputs/evaluation_report.md
!outputs/.gitkeep
backend/outputs/*
!backend/outputs/generated_affidavit.docx
!backend/outputs/evaluation_report.json
!backend/outputs/evaluation_report.md
!backend/outputs/.gitkeep

# --- Node / Frontend Artifacts (for UI integration) ---
node_modules/
.next/
.turbo/
.parcel-cache/
*.tsbuildinfo
coverage/

# --- Tooling & Agent Internal Cache ---
.agents/
.antigravity/
