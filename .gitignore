# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# --- Environment Variables & Secrets (CRITICAL: NEVER COMMIT) ---
.env
.env.*
!.env.example
*.local

# --- Python Cache & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Operating System Files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Logs & Diagnostics ---
*.log
logs/

# --- Scratch & Temporary Test Files ---
scratch/
temp/
tmp/
*.tmp

# --- Outputs Directory ---
# Ignore all generated ad-hoc files; keep only the official assignment deliverables
backend/outputs/*
!backend/outputs/generated_affidavit.docx
!backend/outputs/evaluation_report.json
!backend/outputs/evaluation_report.md
!backend/outputs/.gitkeep

# --- Node / Web (if any frontend added) ---
node_modules/
.next/
