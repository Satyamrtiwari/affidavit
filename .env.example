# ==============================================================================
# Environment Configuration — Affidavit AI System
# Copy this file to `backend/.env` and add your Groq API key
# ==============================================================================

# API Keys (Get your free key from https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model Configuration
GROQ_MODEL=openai/gpt-oss-120b

# App Settings
APP_ENV=development
APP_DEBUG=true
